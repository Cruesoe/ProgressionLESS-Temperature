<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Replace Stuff - Continued</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <VEF.Buildings.HiddenDesignatorsDef>
              <defName>FernyVETemperatureReplaceStuffProgTemperature_HiddenDesignators</defName>
              <hiddenDesignators>
                <li>Cooler_Over</li>
                <li>Vent_Over</li>
              </hiddenDesignators>
            </VEF.Buildings.HiddenDesignatorsDef>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Heater"]/label</xpath>
    <value>
      <label>standing heater</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VTE_WallHeater"]/label</xpath>
    <value>
      <label>heater</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Heater"]/researchPrerequisites</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="Heater"]/researchPrerequisites</xpath>
      <value>
        <researchPrerequisites>
          <li>AirConditioning</li>
        </researchPrerequisites>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Heater"]</xpath>
      <value>
        <researchPrerequisites>
          <li>AirConditioning</li>
        </researchPrerequisites>
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="VTE_WallMountedHeater"]/researchPrerequisites</xpath>
    <value>
      <researchPrerequisites Inherit="False">
        <li>AirConditioning</li>
      </researchPrerequisites>
    </value>
  </Operation>
  <!-- Ceiling fans unlock with Air conditioning -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="VTE_LargeCeilingFan" or defName="VTE_SmallCeilingFan"]/researchPrerequisites</xpath>
    <value>
      <researchPrerequisites Inherit="False">
        <li>AirConditioning</li>
      </researchPrerequisites>
    </value>
  </Operation>
  <!-- HVAC holds the industrial cooler and heater -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="VTE_IndustrialCooler" or defName="VTE_IndustrialHeater"]/researchPrerequisites</xpath>
    <value>
      <researchPrerequisites>
        <li>VTE_HVAC</li>
      </researchPrerequisites>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="VTE_HVAC"]/label</xpath>
    <value>
      <label>industrial climate control</label>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="VTE_HVAC"]/description</xpath>
    <value>
      <description>Build HVAC systems, connecting AC control units and compressors to AC units via air ducts, and hefty industrial coolers and heaters for large rooms and walk-in freezers.</description>
    </value>
  </Operation>
</Patch>
